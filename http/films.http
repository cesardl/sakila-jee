### Films. Self-contained: logs in first, so it can be run on its own.

### Log in.
# @name login
POST {{host}}/auth/token
Content-Type: application/json

{"username": "{{username}}", "password": "{{password}}"}

> ./save-token.js

### Page of films.
GET {{host}}/films?page=0&size=3
Authorization: Bearer {{auth_token}}

> {%
    // IntelliJ returns response.body parsed on some versions and raw on others.
    var body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("200 JSON", function () {
        client.assert(response.status === 200, "expected 200, got " + response.status);
        client.assert(response.contentType.mimeType === "application/json", "expected JSON");
    });

    client.test("page is honoured", function () {
        client.assert(body.content.length === 3,
            "expected 3 rows, got " + body.content.length);
    });

    client.test("film 1 is ACADEMY DINOSAUR", function () {
        var first = body.content[0];
        client.assert(first.filmId === 1 && first.title === "ACADEMY DINOSAUR",
            "unexpected first row: " + JSON.stringify(first));
        client.assert(first.language.name === "English", "language was not resolved");
    });

    // Stock sakila-data.sql ships exactly 1000 films. Anything above that is left over
    // from a POST that was never cleaned up - there is no DELETE /films to undo one.
    if (body.totalElements !== 1000) {
        client.log("WARNING: " + body.totalElements + " films, expected 1000. "
            + (body.totalElements - 1000) + " leftover row(s) from past create runs.");
    }
%}

### Sorting is Spring Data's, straight off Pageable - worth pinning so a later
# controller change cannot quietly drop it.
GET {{host}}/films?size=1&sort=title,desc
Authorization: Bearer {{auth_token}}

> {%
    // IntelliJ returns response.body parsed on some versions and raw on others.
    var body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("desc sort puts ZORRO ARK first", function () {
        client.assert(response.status === 200, "expected 200, got " + response.status);
        client.assert(body.content[0].title === "ZORRO ARK",
            "sort ignored - got " + body.content[0].title);
    });
%}

### Single film.
GET {{host}}/films/1
Authorization: Bearer {{auth_token}}

> {%
    // IntelliJ returns response.body parsed on some versions and raw on others.
    var body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("200 with film 1", function () {
        client.assert(response.status === 200, "expected 200, got " + response.status);
        client.assert(body.title === "ACADEMY DINOSAUR", "wrong film");
        client.assert(body.rating === "PARENTAL_GUIDANCE_SUGGESTED",
            "rating serialised as " + body.rating
            + " - RatingConverter maps the DB code, JSON uses the enum name");
    });
%}

### Unknown film -> 404.
GET {{host}}/films/9999
Authorization: Bearer {{auth_token}}

> {%
    client.test("404 for an unknown film", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### Film id above 32767. Film.filmId was Short while FilmRepository is typed
# JpaRepository<Film, Integer>, so any id past Short.MAX_VALUE blew up in the
# Integer->Short conversion instead of missing cleanly: a 500 where a 404 belongs, and
# films 32768-65535 unreachable even though film_id is SMALLINT UNSIGNED (max 65535).
# The entity now uses Integer, matching the repository, DTO and controller.
GET {{host}}/films/40000
Authorization: Bearer {{auth_token}}

> {%
    client.test("404 above the old Short ceiling", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### The top of the SMALLINT UNSIGNED range must also answer cleanly.
GET {{host}}/films/65535
Authorization: Bearer {{auth_token}}

> {%
    client.test("404 at the top of the column range", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### ---------------------------------------------------------------------------
### Rejection cases. These are safe to run - nothing is written.
### ---------------------------------------------------------------------------

### Client-supplied id on create -> 400.
POST {{host}}/films
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "filmId": 1,
  "title": "Rejected film",
  "language": {"id": 1},
  "rentalRate": 0.99,
  "replacementCost": 20.99
}

> {%
    client.test("400 when the payload sets an id", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status);
    });
%}

### Unregistered language -> 404.
POST {{host}}/films
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "title": "Rejected film",
  "language": {"id": 100},
  "rentalRate": 0.99,
  "replacementCost": 20.99
}

> {%
    client.test("404 for a language that does not exist", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### Missing required field -> 400.
POST {{host}}/films
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{"title": "Rejected film", "language": {"id": 1}}

> {%
    client.test("400 when rentalRate/replacementCost are missing", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status);
    });
%}

### The one request that writes a film lives in films-write.http, on its own,
### because it cannot be undone through the API and IntelliJ has no way to skip
### a request during "Run all". Everything in THIS file is read-only.
